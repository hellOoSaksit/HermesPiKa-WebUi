#!/command/with-contenv sh
# SPDX-License-Identifier: MIT AND LicenseRef-Commons-Clause-1.0
# First-start setup for hpk in the Hermes image (runs as root, acts as hermes).
#   - hpk install: hooks and skills into /opt/data/config.yaml (idempotent; a
#     backup is kept). The image chose hpk, so its hooks are allowed here.
#   - HPK_OWNER (first start): team mode on; the owner's token goes to
#     /opt/data/hpk/owner-token (mode 600), never to the log.
set -e
export HOME=/opt/data HERMES_HOME=/opt/data HPK_HOME=/opt/data
as_hermes() { if [ "$(id -u)" = 0 ]; then s6-setuidgid hermes "$@"; else "$@"; fi; }

cd /opt/data
as_hermes hpk install --yes > /dev/null
as_hermes /opt/hermes/.venv/bin/python /opt/hpk/hermes-consent.py --refresh > /dev/null
echo "[hpk] installed into Hermes; hooks allowed"

if [ ! -f /opt/data/hpk/team.yaml ] && [ -n "${HPK_OWNER:-}" ]; then
  if [ "${HPK_AUTH:-token}" = header ]; then
    as_hermes hpk team init --owner "$HPK_OWNER" --auth header --header "${HPK_HEADER:?set HPK_HEADER}" --proxy "${HPK_PROXY:?set HPK_PROXY}" > /dev/null
    echo "[hpk] team mode on; $HPK_OWNER signs in through the proxy"
  else
    as_hermes sh -c 'umask 077; hpk team init --owner "$1" | grep -o "hpk_[0-9a-f]*" > /opt/data/hpk/owner-token' sh "$HPK_OWNER"
    echo "[hpk] team mode on; the owner's token is in /opt/data/hpk/owner-token (read it once, then delete it)"
  fi
fi
